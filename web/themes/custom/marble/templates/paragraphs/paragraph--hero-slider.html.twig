{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}

{# Build slide array #}
{% set slides = [] %}

<div{{ attributes.addClass(classes) }}>
  {% for slide in paragraph.field_slides %}
    {% set slides = slides|merge([{
      title: slide.entity.field_title.0.value,
      text: slide.entity.field_short_text.0.value|striptags,
      image: file_url(slide.entity.field_background_image.entity.field_media_image.entity.uri.value)
     
    }]) %}
  {% endfor %}

{# Render SDC #}
{% include "marble:hero-slider" with {
  slides: slides,
  options: '{"autoplay": true, "interval": 4000}',
} %}
  
</div>

