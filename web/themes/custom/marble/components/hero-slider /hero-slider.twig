{{ attach_library('marble/hero-slider') }}
<div class="splide hero-slider-component h-auto w-full overflow-hidden" data-hero-slider-options="{{ options|default("{}") }}">
  <div class="splide__track">
    <ul class="splide__list">
      {% for slide in images %}
        <li class="splide__slide">
          <div class="relative">
            <div class="slide__image h-[37.5rem] md:h-auto">{{ slide.image }}</div>
            <div class="absolute top-0 px-[3.75rem] py-[2.75rem] h-full text-white max-w-[700px] flex flex-col justify-center">
              {% if slide.title %}
                <h2 class="!text-white text-2xl lg:text-4xl !my-0 lg:!my-[0.625rem]">{{ slide.title }}</h2>
              {% endif %}
              {% if slide.short_text %}
                <p class="text-base lg:text-xl leading-[1.5]">{{ slide.short_text|striptags }}</p>
              {% endif %}
            </div>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>
